get_our_top_features <- function(stage, model, k) {
  master_dir <- MASTER_DIRS[[stage]]
  csv_path <- file.path(master_dir, model, CSV_NAMES[[stage]])
  if (!file.exists(csv_path)) {
    warning(sprintf("Could not find %s for stage=%s, model=%s \u2014 feature agreement will be blank.",
                    csv_path, stage, model))
    return(character(0))
  }
  raw <- read.csv(csv_path, row.names = 1, stringsAsFactors = FALSE)
  ranked <- raw %>%
    rename(importance = numeric_val, feature = feature_names) %>%
    arrange(desc(importance))
  head(ranked$feature, k)
}
features_agree <- function(our_features, saif_features) {
  if (length(saif_features) == 0 || length(our_features) == 0) return(character(0))
  our_lower  <- tolower(our_features)
  saif_lower <- tolower(saif_features)
  keywords <- c("creatinine", "hemoglobin", "race", "age", "map", "sbp",
                "bilirubin", "albumin", "meld", "inr", "bypass")
  agreements <- character(0)
  for (sf in saif_features) {
    hit_kw <- keywords[sapply(keywords, function(kw) grepl(kw, tolower(sf)))]
    if (length(hit_kw) == 0) next
    matched_ours <- our_features[sapply(our_lower, function(of) any(sapply(hit_kw, function(kw) grepl(kw, of))))]
    if (length(matched_ours) > 0) {
      agreements <- c(agreements, sprintf("%s \u2194 %s", sf, paste(unique(matched_ours), collapse = "; ")))
    }
  }
  agreements
}

comparison_rows <- list()

for (stage in names(SAIF_RESULTS)) {
  
  saif <- SAIF_RESULTS[[stage]]
  ours <- OUR_BEST_MODEL[[stage]]
  
  our_features <- get_our_top_features(stage, ours$model, ours$k)
  agreements <- features_agree(our_features, saif$features)
  
  fewer_features <- if (!is.na(saif$k)) (ours$k < saif$k) else NA
  better_auc     <- if (!is.na(saif$test_auc)) (ours$test_auc > saif$test_auc) else NA
  
  comparison_rows[[stage]] <- data.frame(
    Stage = stage,
    Our_Model = ours$model,
    Our_k = ours$k,
    Our_Test_AUC = ours$test_auc,
    Our_Test_PRAUC = ours$test_prauc,
    Our_Test_F1 = ours$test_f1,
    Saif_Model = saif$model,
    Saif_k = saif$k,
    Saif_Test_AUC = saif$test_auc,
    Saif_Test_PRAUC = saif$test_prauc,
    Saif_Test_F1 = saif$test_f1,
    Better_AUC_Than_Saif = better_auc,
    Fewer_Features_Than_Saif = fewer_features,
    Our_Top_Features = paste(our_features, collapse = "; "),
    Saif_Features = paste(saif$features, collapse = "; "),
    Feature_Agreement = paste(agreements, collapse = " | "),
    stringsAsFactors = FALSE
  )
}

