#1. Helper

discover_models <- function(master_dir, csv_name) {
  if (!dir.exists(master_dir)) {
    warning(sprintf("MASTER_DIR does not exist, skipping: %s", master_dir))
    return(data.frame(model = character(0), csv_path = character(0)))
  }
  
  model_dirs <- list.dirs(master_dir, recursive = FALSE, full.names = TRUE)
  model_csvs <- file.path(model_dirs, csv_name)
  found <- file.exists(model_csvs)
  
  data.frame(
    model = basename(model_dirs)[found],
    csv_path = model_csvs[found],
    stringsAsFactors = FALSE
  )
}

#Shared theme

theme_report <- function(base_size = 11) {
  theme_minimal(base_size = base_size) +
    theme(
      plot.title = element_text(face = "bold", size = base_size + 3),
      plot.subtitle = element_text(color = "grey35", size = base_size),
      axis.title = element_text(face = "bold"),
      panel.grid.minor = element_blank(),
      panel.grid.major = element_line(color = "grey90"),
      panel.background = element_rect(fill = "white", color = NA),
      plot.background  = element_rect(fill = "white", color = NA),
      legend.background = element_rect(fill = "white", color = NA),
      plot.margin = margin(12, 16, 12, 12)
    )
}

#2. Function: build all 4 figures for ONE model

make_figures_for_model <- function(model_name, csv_path, stage, output_dir) {
  stage_tag <- gsub(" \\+ ", "_", stage)
  stage_tag <- gsub("[^A-Za-z0-9_]", "", stage_tag)
  
  tag <- sprintf("%s_%s", stage_tag, model_name)  # e.g. Intraoperative_rf, Preoperative_Intraoperative_rf
  cat(sprintf("Processing: %s\n", tag))
  
  raw <- tryCatch(
    read.csv(csv_path, row.names = 1, stringsAsFactors = FALSE),
    error = function(e) {
      warning(sprintf("Skipping '%s' — could not read CSV: %s", model_name, e$message))
      return(NULL)
    }
  )
  if (is.null(raw)) return(invisible(NULL))
  
  features <- raw %>%
    rename(importance = numeric_val, feature = feature_names) %>%
    arrange(desc(importance)) %>%
    mutate(
      rank = row_number(),
      used_in_model = rank <= K_MAX
    )
  
  n_features <- nrow(features)
  
  # ---- Figure 1: Top 20 features ----
  top_n <- min(20, n_features)
  top20 <- features %>% slice_head(n = top_n)

  optimum <- OUR_BEST_MODEL[[stage]]
  is_optimum_model <- !is.null(optimum) && identical(optimum$model, model_name)
  k_used <- if (is_optimum_model) optimum$k else top_n
  top20 <- top20 %>% mutate(is_used = rank <= k_used)

  legend_label_used <- sprintf("Used by optimum model (top %d)", k_used)
  legend_label_unused <- "Not used by optimum model"

  fig1 <- ggplot(top20, aes(x = importance, y = fct_reorder(feature, importance), fill = is_used)) +
    geom_col(width = 0.72) +
    geom_text(aes(label = sprintf("%.3f", importance), color = is_used),
              hjust = -0.15, size = 4.2, fontface = "bold") +
    scale_fill_manual(values = c(`TRUE` = "#1E2761", `FALSE` = "#B8BFCC"),
                       labels = c(`TRUE` = legend_label_used, `FALSE` = legend_label_unused),
                       name = NULL) +
    scale_color_manual(values = c(`TRUE` = "#111111", `FALSE` = "#6B7280"), guide = "none") +
    scale_x_continuous(limits = c(0, max(top20$importance) * 1.12),
                       expand = expansion(mult = c(0, 0.02))) +
    labs(
      title = sprintf("%s, %s: Feature Importance (varImp)", stage, model_name),
      x = "Importance Score", y = NULL
    ) +
    theme_report(base_size = 13) +
    theme(
      axis.text.y = element_text(size = 15, face = "bold", color = "#111111"),
      axis.text.x = element_text(size = 11),
      legend.position = "bottom",
      legend.text = element_text(size = 12)
    )

  ggsave(file.path(output_dir, sprintf("%s_fig1_top20_importance.png", tag)), fig1,
         width = 11, height = 8.6, dpi = 300, bg = "white")

  
  # ---- Figure 2: Full ranked dot plot with K cutoff band ----
  fig2 <- ggplot(features, aes(x = rank, y = importance)) +
    annotate("rect", xmin = K_MIN - 0.5, xmax = K_MAX + 0.5, ymin = -Inf, ymax = Inf,
             fill = "#B7E1CD", alpha = 0.4) +
    geom_line(color = "grey60", linewidth = 0.4) +
    geom_point(aes(color = used_in_model), size = 2) +
    geom_vline(xintercept = c(K_MIN, K_MAX), linetype = "dashed", color = "#1B3A6B", linewidth = 0.4) +
    annotate("text", x = (K_MIN + K_MAX) / 2, y = max(features$importance) * 0.98,
             label = sprintf("K = %d..%d feature range\nused in base-learner models", K_MIN, K_MAX),
             size = 3.2, color = "#1B3A6B", fontface = "italic") +
    scale_color_manual(values = c(`TRUE` = "#1B3A6B", `FALSE` = "grey70"), guide = "none") +
    scale_x_continuous(breaks = pretty_breaks(10)) +
    labs(
      title = sprintf("All Features Ranked by Importance \u2014 %s", stage),
      subtitle = sprintf("%d features total; shaded band = features selectable within K = %d-%d",
                         n_features, K_MIN, K_MAX),
      x = "Feature Rank", y = "Importance Score"
    ) +
    theme_report()
  
  ggsave(file.path(output_dir, sprintf("%s_fig2_full_ranked_dotplot.png", tag)), fig2,
         width = 9, height = 6, dpi = 300, bg = "white")
  
  # ---- Figure 3: Distribution of importance scores ----
  fig3 <- ggplot(features, aes(x = importance)) +
    geom_histogram(bins = 20, fill = "#1B3A6B", color = "white", alpha = 0.85) +
    geom_vline(xintercept = median(features$importance), linetype = "dashed", color = "#D9534F") +
    annotate("text", x = median(features$importance), y = Inf,
             label = sprintf("median = %.3f", median(features$importance)),
             vjust = 1.5, hjust = -0.05, size = 3.2, color = "#D9534F") +
    labs(
      title = sprintf("Distribution of Feature Importance Scores \u2014 %s", stage),
      subtitle = sprintf("n = %d features", n_features),
      x = "Importance Score", y = "Number of Features"
    ) +
    theme_report()
  
  ggsave(file.path(output_dir, sprintf("%s_fig3_score_distribution.png", tag)), fig3,
         width = 8, height = 5.5, dpi = 300, bg = "white")
  
  #Figure 4: Cumulative share of total importance
  features <- features %>%
    mutate(
      cum_importance = cumsum(importance),
      cum_share = cum_importance / sum(importance)
    )
  
  k_labels <- features %>% filter(rank %in% c(K_MIN, min(K_MAX, n_features)))
  
  fig4 <- ggplot(features, aes(x = rank, y = cum_share)) +
    geom_line(color = "#1B3A6B", linewidth = 0.9) +
    geom_point(data = k_labels, color = "#D9534F", size = 2.5) +
    geom_text(data = k_labels, aes(label = sprintf("K=%d\n%.0f%%", rank, cum_share * 100)),
              vjust = -0.6, size = 3.2, color = "#D9534F") +
    scale_y_continuous(labels = percent_format(accuracy = 1)) +
    scale_x_continuous(breaks = pretty_breaks(10)) +
    labs(
      title = sprintf("Cumulative Share of Total Importance \u2014 %s", stage),
      subtitle = "As additional ranked features are added",
      x = "Number of Top Features Included (K)", y = "Cumulative Share of Total Importance"
    ) +
    theme_report()
  
  ggsave(file.path(output_dir, sprintf("%s_fig4_cumulative_score.png", tag)), fig4,
         width = 8.5, height = 5.5, dpi = 300, bg = "white")
  
  cat(sprintf("  -> 4 figures written for %s\n", model_name))
  invisible(NULL)
}

#3. Loop over every stage, then every model within it

total_processed <- 0

for (stage in names(MASTER_DIRS)) {
  
  master_dir <- MASTER_DIRS[[stage]]
  cat(sprintf("\n=== Stage: %s ===\n", stage))
  cat(sprintf("MASTER_DIR: %s\n", master_dir))
  
  csv_name <- CSV_NAMES[[stage]]
  cat(sprintf("Looking for: %s\n", csv_name))
  
  models_df <- discover_models(master_dir, csv_name)
  
  if (nrow(models_df) == 0) {
    cat(sprintf("  No '%s' files found under any subfolder \u2014 skipping this stage.\n", csv_name))
    next
  }
    output_dir <- file.path(master_dir, "figures")
  dir.create(output_dir, showWarnings = FALSE)
  
  cat(sprintf("  Found %d model folders. Figures will be saved to:\n  %s\n",
              nrow(models_df), output_dir))
  
  for (i in seq_len(nrow(models_df))) {
    make_figures_for_model(models_df$model[i], models_df$csv_path[i], stage, output_dir)
    total_processed <- total_processed + 1
  }
}

