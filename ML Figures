#Shared theme
theme_ml <- function(base_size = 10) {
  theme_classic(base_size = base_size) +
    theme(
      text             = element_text(family = "serif"),
      plot.title       = element_text(face = "bold", size = base_size + 1,
                                      hjust = 0.5, margin = margin(b = 5)),
      plot.subtitle    = element_text(size = base_size - 1, hjust = 0.5,
                                      color = "grey40", margin = margin(b = 4)),
      axis.title       = element_text(size = base_size),
      axis.text        = element_text(size = base_size - 1),
      legend.text      = element_text(size = base_size - 1),
      legend.title     = element_blank(),
      legend.key.size  = unit(0.45, "cm"),
      legend.background = element_rect(fill = alpha("white", 0.85), color = NA),
      panel.grid.major = element_line(color = "grey90", linewidth = 0.35),
      panel.grid.minor = element_blank(),
      strip.text       = element_text(face = "bold", size = base_size),
      strip.background = element_rect(fill = "grey95", color = NA),
      plot.margin      = margin(8, 8, 8, 8)
    )
}

# 2. HELPER FUNCTIONS

add_ribbon_cols <- function(df) {
  df %>%
    mutate(
      ymin_red  = ifelse(AUC_Gap >  GAP_THRESHOLD, Test_AUC,  NA_real_),
      ymax_red  = ifelse(AUC_Gap >  GAP_THRESHOLD, Train_AUC, NA_real_),
      ymin_blue = ifelse(Test_AUC > Train_AUC, Train_AUC, NA_real_),
      ymax_blue = ifelse(Test_AUC > Train_AUC, Test_AUC,  NA_real_),
      ymin_ok   = ifelse(AUC_Gap > 0 & AUC_Gap <= GAP_THRESHOLD, Test_AUC,  NA_real_),
      ymax_ok   = ifelse(AUC_Gap > 0 & AUC_Gap <= GAP_THRESHOLD, Train_AUC, NA_real_)
    )
}

geom_opt_diamonds <- function(df, opt_k_vec, metric_col, size = 4.5) {
  opt_rows <- df %>%
    rowwise() %>%
    filter(FeatureNumber == opt_k_vec[ModelName]) %>%
    ungroup()
  list(
    geom_point(data = opt_rows,
               aes(x = FeatureNumber, y = .data[[metric_col]],
                   color = ModelName),
               shape = 18, size = size, stroke = 0.5,
               show.legend = FALSE)
  )
}

geom_opt_vlines <- function(models, opt_k_vec) {
  vline_df <- data.frame(
    ModelName = factor(models, levels = models),
    opt_k     = as.integer(opt_k_vec[models])
  )
  geom_vline(data = vline_df,
             aes(xintercept = opt_k),
             color = "grey30", linetype = "dotted", linewidth = 0.8)
}

gap_label_df <- function(df, models, opt_k_vec, include_min = FALSE) {
  df %>%
    filter(ModelName %in% models) %>%
    group_by(ModelName) %>%
    summarise(
      max_gap = round(max(AUC_Gap), 3),
      min_gap = round(min(AUC_Gap), 3),
      .groups = "drop"
    ) %>%
    mutate(
      label     = if (include_min)
                    paste0("Max: ", max_gap, "\nMin: ", min_gap)
                  else
                    paste0("Max gap: ", max_gap),
      gap_color = ifelse(max_gap > GAP_THRESHOLD, "#C62828", "#2E7D32"),
      ModelName = factor(ModelName, levels = models)
    )
}
make_traintestfig <- function(df, sel_models, opt_k_vec,
                              title, subtitle,
                              include_blue = FALSE,
                              y_lo = 0.35, y_hi = 0.98) {
  dat <- df %>%
    filter(ModelName %in% sel_models) %>%
    mutate(ModelName = factor(ModelName, levels = sel_models)) %>%
    add_ribbon_cols()

  dat_red  <- dat %>% filter(!is.na(ymin_red))
  dat_ok   <- dat %>% filter(!is.na(ymin_ok))
  dat_blue <- dat %>% filter(!is.na(ymin_blue))

  gap_labs <- gap_label_df(dat, sel_models, opt_k_vec,
                           include_min = include_blue)

  p <- ggplot(dat, aes(x = FeatureNumber))

  if (nrow(dat_red)  > 0)
    p <- p + geom_ribbon(data = dat_red,
                         aes(ymin = ymin_red, ymax = ymax_red),
                         fill = "#F44336", alpha = 0.18, color = NA)
  if (nrow(dat_ok)   > 0)
    p <- p + geom_ribbon(data = dat_ok,
                         aes(ymin = ymin_ok, ymax = ymax_ok),
                         fill = "grey60", alpha = 0.10, color = NA)
  if (include_blue && nrow(dat_blue) > 0)
    p <- p + geom_ribbon(data = dat_blue,
                         aes(ymin = ymin_blue, ymax = ymax_blue),
                         fill = "#1565C0", alpha = 0.14, color = NA)

  p <- p +
    geom_line(aes(y = Train_AUC, color = ModelName),
              linewidth = 1.2, linetype = "solid") +
    geom_line(aes(y = Test_AUC,  color = ModelName),
              linewidth = 1.2, linetype = "dashed", alpha = 0.85) +
    geom_opt_vlines(sel_models, opt_k_vec) +
    geom_opt_diamonds(dat, opt_k_vec, "Test_AUC", size = 4.5) +
    geom_text(data = gap_labs,
              aes(x = 24.5, y = y_lo + 0.03,
                  label = label, color = gap_color),
              size = 2.6, hjust = 1, family = "serif",
              show.legend = FALSE) +
    scale_color_manual(values = c(MODEL_COLORS,
                                  "#C62828" = "#C62828",
                                  "#2E7D32" = "#2E7D32")) +
    scale_fill_manual(values  = MODEL_COLORS, guide = "none") +
    scale_x_continuous(breaks = c(2, 5, 10, 15, 20, 25)) +
    scale_y_continuous(limits = c(y_lo, y_hi),
                       labels = number_format(accuracy = 0.01)) +
    facet_wrap(~ModelName, ncol = 3) +
    labs(title = title, subtitle = subtitle,
         x = "Number of Features (k)", y = "AUROC") +
    theme_ml() +
    theme(legend.position = "none")

  p
}

make_allmodels_fig <- function(df, all_models, opt_k_vec,
                               title, include_blue = FALSE) {
  dat <- df %>%
    mutate(ModelName = factor(ModelName, levels = all_models)) %>%
    add_ribbon_cols()

  vline_df <- data.frame(
    ModelName = factor(all_models, levels = all_models),
    opt_k     = as.integer(opt_k_vec[all_models])
  )
  opt_rows <- dat %>%
    rowwise() %>%
    filter(FeatureNumber == opt_k_vec[as.character(ModelName)]) %>%
    ungroup()

  dat_red  <- dat %>% filter(!is.na(ymin_red))
  dat_blue <- dat %>% filter(!is.na(ymin_blue))

  p <- ggplot(dat, aes(x = FeatureNumber))

  if (nrow(dat_red)  > 0)
    p <- p + geom_ribbon(data = dat_red,
                         aes(ymin = ymin_red, ymax = ymax_red),
                         fill = "#F44336", alpha = 0.22, color = NA)
  if (include_blue && nrow(dat_blue) > 0)
    p <- p + geom_ribbon(data = dat_blue,
                         aes(ymin = ymin_blue, ymax = ymax_blue),
                         fill = "#1565C0", alpha = 0.14, color = NA)

  p <- p +
    geom_line(aes(y = Train_AUC, color = ModelName),
              linewidth = 0.75, linetype = "solid", alpha = 0.85) +
    geom_line(aes(y = Test_AUC,  color = ModelName),
              linewidth = 0.75, linetype = "dashed", alpha = 0.85) +
    geom_vline(data = vline_df,
               aes(xintercept = opt_k),
               color = "grey40", linetype = "dotted", linewidth = 0.6) +
    geom_point(data = opt_rows,
               aes(x = FeatureNumber, y = Test_AUC, color = ModelName),
               shape = 18, size = 2.8, show.legend = FALSE) +
    scale_color_manual(values = MODEL_COLORS, guide = "none") +
    scale_x_continuous(breaks = c(2, 5, 10, 15, 20, 25)) +
    scale_y_continuous(limits = c(0.25, 1.0),
                       labels = number_format(accuracy = 0.01)) +
    facet_wrap(~ModelName, ncol = 5) +
    labs(
      title    = title,
      subtitle = paste("Solid = Train  |  Dashed = Test  |",
                       "Red shading = gap > 0.05",
                       if (include_blue) "|  Blue shading = test exceeds train" else "",
                       "|  Diamond = recommended k"),
      x = "Number of Features (k)",
      y = "AUROC"
    ) +
    theme_ml(base_size = 9) +
    theme(strip.text = element_text(size = 7.5, face = "bold"))

  p
}
make_topmodels_fig <- function(df, top_models, opt_k_vec,
                               title, subtitle,
                               y_lo = 0.45, y_hi = 0.90,
                               ref_line = NULL, ref_label = NULL) {
  dat <- df %>% filter(ModelName %in% top_models)

  p <- dat %>%
    ggplot(aes(x = FeatureNumber, y = Test_AUC,
               color = ModelName, group = ModelName)) +
    geom_line(linewidth = 0.9) +
    geom_point(size = 2.2) +
    geom_opt_diamonds(dat, opt_k_vec, "Test_AUC") +
    scale_color_manual(values = MODEL_COLORS) +
    scale_x_continuous(breaks = seq(2, 25, 3)) +
    scale_y_continuous(limits = c(y_lo, y_hi),
                       labels = number_format(accuracy = 0.01)) +
    labs(title = title, subtitle = subtitle,
         x = "Number of Features (k)", y = "Test Set AUROC") +
    theme_ml()

  if (!is.null(ref_line)) {
    p <- p +
      geom_hline(yintercept = ref_line, linetype = "dotted",
                 color = "grey30", linewidth = 0.7) +
      annotate("text", x = 24.5, y = ref_line + 0.006,
               label = ref_label, size = 2.8, hjust = 1,
               color = "grey30", family = "serif")
  }
  p
}

# PRAUC line chart
make_prauc_fig <- function(df, top_models, opt_k_vec, prevalence,
                           title, dataset_label) {
  dat <- df %>% filter(ModelName %in% top_models)

  dat %>%
    ggplot(aes(x = FeatureNumber, y = Test_PRAUC,
               color = ModelName, group = ModelName)) +
    geom_hline(yintercept = prevalence, linetype = "dotted",
               color = "grey30", linewidth = 0.8) +
    annotate("text", x = 24.5, y = prevalence + 0.006,
             label = paste0("No-skill (~", scales::percent(prevalence, 0.1), " PRF)"),
             size = 2.8, hjust = 1, color = "grey30", family = "serif") +
    geom_line(linewidth = 0.9) +
    geom_point(size = 2.2) +
    geom_opt_diamonds(dat, opt_k_vec, "Test_PRAUC") +
    scale_color_manual(values = MODEL_COLORS) +
    scale_x_continuous(breaks = seq(2, 25, 3)) +
    labs(title    = paste("Test PRAUC vs Feature Count — Top Models",
                          paste0("(", dataset_label, ")")),
         subtitle = "Diamond = recommended k  |  Dotted = no-skill baseline",
         x = "Number of Features (k)", y = "Test Set PRAUC") +
    theme_ml()
}


