# STEP 13 — Stratified 70/30 train-test split

log_msg("\n--- Step 13: Stratified 70/30 train-test split ---")

make_split <- function(df, name) {
  n_total <- nrow(df)
  n_pos   <- sum(df$PRF == 1, na.rm = TRUE)
  n_neg   <- sum(df$PRF == 0, na.rm = TRUE)

  # createDataPartition needs >=2 total rows, and a stratified 70/30 split
  # needs >=2 patients in EACH class to be meaningful at all. If a case fails
  # this, it's because its cohort filter (e.g. requiring BOTH intraop AND
  # postop BP present) leaves too few patients or only one PRF class.
  if (n_total < 2 || n_pos < 2 || n_neg < 2) {
    log_msg(sprintf(
      paste0("  SKIPPING %-20s -- insufficient data for a stratified split ",
             "(n=%d total, PRF=1: %d, PRF=0: %d; need >=2 in each class). ",
             "This case's cohort filter (BP-availability requirement and/or ",
             "the CABG/Valve + missingness exclusions upstream) is leaving too ",
             "few patients. Review the case-construction log above for this ",
             "case's patient count before the split."),
      name, n_total, n_pos, n_neg))
    return(NULL)
  }
  if (n_pos < 10 || n_neg < 10) {
    log_msg(sprintf(
      "  NOTE: %-20s has a very small class (PRF=1: %d, PRF=0: %d) -- split will run, but RUS/SMOTE-NC downstream may behave unpredictably with this few events.",
      name, n_pos, n_neg))
  }

  idx   <- createDataPartition(df$PRF, p = 0.70, list = FALSE)
  train <- df[ idx, ]
  test  <- df[-idx, ]
  log_msg(sprintf("  %-22s  train: %d (PRF %.2f%%) | test: %d (PRF %.2f%%)",
                  name, nrow(train), 100*mean(train$PRF),
                  nrow(test),  100*mean(test$PRF)))
  list(train = train, test = test)
}

ALL_SPLITS <- Map(make_split, ALL_CASES, names(ALL_CASES))
ALL_SPLITS <- Filter(Negate(is.null), ALL_SPLITS)

if (length(ALL_SPLITS) < length(ALL_CASES)) {
