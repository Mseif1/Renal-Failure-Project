# CASE CONSTRUCTION — 7 cases: 3 individual + 4 combinations
#
# Preop-only, intraop-only, postop-only,
# preop+intraop, preop+postop, intraop+postop, preop+intraop+postop.
#
# README constraint carried through: "Only postoperative feature to use:
# Blood pressure. ALL OTHERS ARE associated with the outcome" -> POSTOP_BP_FEATS
# is the only postoperative contribution in any case; Blue procedure features
# (CAB, Valve, Cardiopulmonary Bypass Time) never appear in a postop-only case.

make_case <- function(feature_cols, require_intraop_bp = FALSE,
                      require_postop_bp = FALSE, name) {
  df <- sts_full
  if (require_intraop_bp) df <- filter(df, has_intraop_bp, !flag_missing_bp)
  if (require_postop_bp)  df <- filter(df, has_postop_bp,  !flag_missing_bp)
  df <- select(df, all_of(ID_OUTCOME_COLS), all_of(feature_cols))

  if (nrow(df) == 0) {
    log_msg(sprintf(
      paste0("  %-20s     0 patients -- EMPTY COHORT. This case requires ",
             "%s%s%s BP data, and no patient in this extract satisfies that ",
             "combination given the current phase definition (hours_from_start ",
             "vs. actual surgery duration). Downstream scripts must skip this ",
             "case rather than build a table from it -- check the BP phase ",
             "distribution log above and confirm with the collaborator whether ",
             "this reflects a real data gap or a phase-labeling issue."),
      name,
      if (require_intraop_bp) "intraop " else "",
      if (require_intraop_bp && require_postop_bp) "AND " else "",
      if (require_postop_bp) "postop " else ""))
  } else {
    log_msg(sprintf("  %-20s %5d patients | %3d feature cols | PRF=%.2f%%",
                    name, nrow(df), length(feature_cols), 100 * mean(df$PRF)))
  }
  df
}

