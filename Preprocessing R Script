# BP FEATURE ENGINEERING
# 52 features per phase: 26 MAP + 26 SBP
#   Summary stats    : mean, median, SD, min, max, range, Q1, Q3, IQR, ARV (10)
#   Rates of change  : max rate, min rate, median rate, SD of rates (4)
#   Threshold %      : 3 hypotensive + 3 hypertensive cutoffs (6)
#   Spike/drop %     : drops of 20/40/60 mmHg + spikes of 20/40/60 mmHg (6)
# Thresholds differ between intraoperative and postoperative phases.
# No time-weighting (Step 19 not approved); no winsorisation (Step 18 not approved).

log_msg("\n--- BP feature engineering ---")

INTRA_MAP_LOW  <- c(55, 65, 75);  INTRA_MAP_HIGH <- c(95, 105, 115)
INTRA_SBP_LOW  <- c(70, 80, 90);  INTRA_SBP_HIGH <- c(130, 140, 150)
POST_MAP_LOW   <- c(50, 60, 70);  POST_MAP_HIGH  <- c(95, 105, 115)
POST_SBP_LOW   <- c(80, 90, 100); POST_SBP_HIGH  <- c(170, 180, 190)

compute_bp_features <- function(df_ph, map_low, map_high, sbp_low, sbp_high, prefix) {
  df_ph %>%
    arrange(New_MRN, meas_dt) %>%
    group_by(New_MRN) %>%
    summarise(
      # MAP summary statistics
      MAP_Mean        = mean(mean_bp,   na.rm = TRUE),
      MAP_Median      = median(mean_bp, na.rm = TRUE),
      MAP_SD          = sd(mean_bp,     na.rm = TRUE),
      MAP_Min         = min(mean_bp,    na.rm = TRUE),
      MAP_Max         = max(mean_bp,    na.rm = TRUE),
      MAP_Range       = max(mean_bp,    na.rm = TRUE) - min(mean_bp, na.rm = TRUE),
      MAP_Q1          = quantile(mean_bp, 0.25, na.rm = TRUE),
      MAP_Q3          = quantile(mean_bp, 0.75, na.rm = TRUE),
      MAP_IQR         = quantile(mean_bp, 0.75, na.rm = TRUE) -
                        quantile(mean_bp, 0.25, na.rm = TRUE),
      MAP_ARV         = mean(abs(diff(mean_bp[!is.na(mean_bp)])), na.rm = TRUE),
      # MAP rates of change
      MAP_Rate_Max    = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) max(d)    else NA_real_},
      MAP_Rate_Min    = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) min(d)    else NA_real_},
      MAP_Rate_Median = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) median(d) else NA_real_},
      MAP_Rate_SD     = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) sd(d)     else NA_real_},
      # MAP threshold features
      MAP_Pct_Below_1 = mean(mean_bp < map_low[1],  na.rm = TRUE),
      MAP_Pct_Below_2 = mean(mean_bp < map_low[2],  na.rm = TRUE),
      MAP_Pct_Below_3 = mean(mean_bp < map_low[3],  na.rm = TRUE),
      MAP_Pct_Above_1 = mean(mean_bp > map_high[1], na.rm = TRUE),
      MAP_Pct_Above_2 = mean(mean_bp > map_high[2], na.rm = TRUE),
      MAP_Pct_Above_3 = mean(mean_bp > map_high[3], na.rm = TRUE),
      # MAP spike/drop features
      MAP_Pct_Drop_20  = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) mean(d < -20) else NA_real_},
      MAP_Pct_Drop_40  = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) mean(d < -40) else NA_real_},
      MAP_Pct_Drop_60  = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) mean(d < -60) else NA_real_},
      MAP_Pct_Spike_20 = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) mean(d >  20) else NA_real_},
      MAP_Pct_Spike_40 = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) mean(d >  40) else NA_real_},
      MAP_Pct_Spike_60 = {d <- diff(mean_bp[!is.na(mean_bp)]); if(length(d)) mean(d >  60) else NA_real_},
      # SBP summary statistics
      SBP_Mean        = mean(SBP,   na.rm = TRUE),
      SBP_Median      = median(SBP, na.rm = TRUE),
      SBP_SD          = sd(SBP,     na.rm = TRUE),
      SBP_Min         = min(SBP,    na.rm = TRUE),
      SBP_Max         = max(SBP,    na.rm = TRUE),
      SBP_Range       = max(SBP, na.rm = TRUE) - min(SBP, na.rm = TRUE),
      SBP_Q1          = quantile(SBP, 0.25, na.rm = TRUE),
      SBP_Q3          = quantile(SBP, 0.75, na.rm = TRUE),
      SBP_IQR         = quantile(SBP, 0.75, na.rm = TRUE) -
                        quantile(SBP, 0.25, na.rm = TRUE),
      SBP_ARV         = mean(abs(diff(SBP[!is.na(SBP)])), na.rm = TRUE),
      # SBP rates of change
      SBP_Rate_Max    = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) max(d)    else NA_real_},
      SBP_Rate_Min    = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) min(d)    else NA_real_},
      SBP_Rate_Median = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) median(d) else NA_real_},
      SBP_Rate_SD     = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) sd(d)     else NA_real_},
      # SBP threshold features
      SBP_Pct_Below_1 = mean(SBP < sbp_low[1],  na.rm = TRUE),
      SBP_Pct_Below_2 = mean(SBP < sbp_low[2],  na.rm = TRUE),
      SBP_Pct_Below_3 = mean(SBP < sbp_low[3],  na.rm = TRUE),
      SBP_Pct_Above_1 = mean(SBP > sbp_high[1], na.rm = TRUE),
      SBP_Pct_Above_2 = mean(SBP > sbp_high[2], na.rm = TRUE),
      SBP_Pct_Above_3 = mean(SBP > sbp_high[3], na.rm = TRUE),
      # SBP spike/drop features
      SBP_Pct_Drop_20  = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) mean(d < -20) else NA_real_},
      SBP_Pct_Drop_40  = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) mean(d < -40) else NA_real_},
      SBP_Pct_Drop_60  = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) mean(d < -60) else NA_real_},
      SBP_Pct_Spike_20 = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) mean(d >  20) else NA_real_},
      SBP_Pct_Spike_40 = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) mean(d >  40) else NA_real_},
      SBP_Pct_Spike_60 = {d <- diff(SBP[!is.na(SBP)]); if(length(d)) mean(d >  60) else NA_real_},
      .groups = "drop"
    ) %>%
    # Rename threshold columns with actual mmHg cutoff values
    rename_with(.fn = function(nm) {
      nm <- str_replace(nm, "MAP_Pct_Below_1", paste0("MAP_Pct_Below_", map_low[1]))
      nm <- str_replace(nm, "MAP_Pct_Below_2", paste0("MAP_Pct_Below_", map_low[2]))
      nm <- str_replace(nm, "MAP_Pct_Below_3", paste0("MAP_Pct_Below_", map_low[3]))
      nm <- str_replace(nm, "MAP_Pct_Above_1", paste0("MAP_Pct_Above_", map_high[1]))
      nm <- str_replace(nm, "MAP_Pct_Above_2", paste0("MAP_Pct_Above_", map_high[2]))
      nm <- str_replace(nm, "MAP_Pct_Above_3", paste0("MAP_Pct_Above_", map_high[3]))
      nm <- str_replace(nm, "SBP_Pct_Below_1", paste0("SBP_Pct_Below_", sbp_low[1]))
      nm <- str_replace(nm, "SBP_Pct_Below_2", paste0("SBP_Pct_Below_", sbp_low[2]))
      nm <- str_replace(nm, "SBP_Pct_Below_3", paste0("SBP_Pct_Below_", sbp_low[3]))
      nm <- str_replace(nm, "SBP_Pct_Above_1", paste0("SBP_Pct_Above_", sbp_high[1]))
      nm <- str_replace(nm, "SBP_Pct_Above_2", paste0("SBP_Pct_Above_", sbp_high[2]))
      nm <- str_replace(nm, "SBP_Pct_Above_3", paste0("SBP_Pct_Above_", sbp_high[3]))
      nm
    }) %>%
    rename_with(.fn = ~paste0(prefix, "_", .), .cols = -New_MRN)
}

bp_intra <- filter(bp, bp_phase == "Intraoperative")
bp_post  <- filter(bp, bp_phase == "Postoperative")

log_msg(sprintf("Intraop BP (before excluding first 3 readings/patient): %d readings | %d patients",
