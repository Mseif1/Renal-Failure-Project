# Silently drop any listed column absent from this extract
COLS_TO_KEEP <- COLS_TO_KEEP[COLS_TO_KEEP %in% names(sts_raw)]
sts <- select(sts_raw, all_of(COLS_TO_KEEP))
log_msg(sprintf("Retained %d columns from %d total", ncol(sts), ncol(sts_raw)))



# 4. OPERATIONAL PREREQUISITES
#    (date parsing, race construction, flags)
#    These are data-preparation necessities, not preprocessing tracker steps.

log_msg("\n--- Operational prerequisites ---")

# Parse surgery date
sts <- sts %>%
  mutate(Surgery_Date_parsed = mdy(Surgery_Date))

# Restrict to Saif's exact study window (2021-01-01 to 2024-12-31), if enabled,
# for a direct comparison against his results -- see RESTRICT_TO_2021_2024
# near the top of this script.
if (RESTRICT_TO_2021_2024) {
  n_before <- nrow(sts)
  sts <- filter(sts, Surgery_Date_parsed >= COHORT_DATE_MIN,
               Surgery_Date_parsed <= COHORT_DATE_MAX)
  log_step("2021-2024-RESTRICTION",
           sprintf("Restrict to Saif's study window (%s to %s)",
                   COHORT_DATE_MIN, COHORT_DATE_MAX),
           n_before, nrow(sts))
} else {
  log_msg("RESTRICT_TO_2021_2024 is FALSE -- using the full 2021-2025 cohort.")
}

# Race: binary race columns are 95% NA; construct from Multi-Select columns
sts <- sts %>%
  mutate(
    Race = coalesce(
      `Race - Multi-Select-1`, `Race - Multi-Select-2`,
      `Race - Multi-Select-3`, `Race - Multi-Select-4`,
      `Race - Multi-Select-5`, `Race - Multi-Select-6`
    ),
    Race = case_when(
      Race == "White"                     ~ "White",
      Race == "Black/African American"    ~ "Black/African American",
      Race == "Asian"                     ~ "Asian",
      Race == "Am Indian/Alaskan"         ~ "American Indian/Alaskan Native",
      Race == "Hawaiian/Pacific Islander" ~ "Native Hawaiian/Pacific Islander",
      Race == "Other"                     ~ "Other",
      TRUE                                ~ "Unknown/Not Documented"
    )
  ) %>%
  select(-starts_with("Race - Multi-Select-"))
log_msg("Race variable constructed from Multi-Select columns")
cat(capture.output(print(table(sts$Race, useNA = "always"))), sep = "\n")

n_before <- nrow(sts)
sts <- filter(sts,
              is.na(`Hispanic or Latino or Spanish Ethnicity`) |
                `Hispanic or Latino or Spanish Ethnicity` != "Not Documented")
log_step("EXCL-ETHNICITY", "Exclude Not Documented ethnicity", n_before, nrow(sts))

n_before <- nrow(sts)
sts <- filter(sts, is.na(Race) | Race != "Unknown/Not Documented")
log_step("EXCL-RACE", "Exclude Unknown/Not Documented race", n_before, nrow(sts))


# flag_missing_bp: per collaborator, patients with surgery before 2021-07-01
# had no digitally-captured ANES/OR-monitor BP device readings (bp_id =
# "ANES_BP"), because that specific capture device/system wasn't in place
# yet. NOTE: this does NOT mean pre-2021-07-01 patients lack intraoperative
# BP entirely -- under the current duration-based phase definition (phase is
# decided by hours_from_start vs. actual surgery duration, regardless of
# bp_id/device), most of these patients still have SOME BP row -- from a
# cuff (MAP_BMDI) or arterial line (SBP&DBP_Art) -- falling inside their
# surgical window, so they aren't automatically excluded from intraop-
# requiring cases.
#
# Left as FALSE/inert below because has_intraop_bp/has_postop_bp already
# filter on ACTUAL data presence per patient (built from the real BP file
# rows, using the duration-based phase, not device/anchor type), which
# handles device availability correctly without needing a separate
# hardcoded date rule. Kept as a named flag in case a future extract needs
# an explicit date-based override.
sts <- sts %>%
  mutate(
    flag_missing_bp = FALSE,
    # Emergent Salvage: very high mortality; flagged for analyst review
    flag_emergent_salvage = (!is.na(Status) & Status == "Emergent Salvage")
  )

log_msg(sprintf("flag_missing_bp (pre-2021-07-01): %d patients",
                sum(sts$flag_missing_bp)))
log_msg(sprintf("flag_emergent_salvage: %d patients (not excluded; analyst decision)",
                sum(sts$flag_emergent_salvage)))



# 5. PRF OUTCOME CONSTRUCTION

# Postoperative creatinine = maximum of two peak values:
#   (a) within 48h of OR exit
#   (b) prior to discharge
# Patients where both are NA and no dialysis recorded -> indeterminate -> excluded.
# Post-Op-Renal-Dialysis Req: blank in STS = not required (treated as No).
log_msg("\n--- PRF outcome construction ---")

sts <- sts %>%
  mutate(
    creatinine_baseline   = `Last Creatinine Level`,
    creatinine_postop     = pmax(
      `Peak Postoperative Creatinine Level within 48 hours of OR Exit`,
      `Peak Postoperative Creatinine Level prior to discharge`,
      na.rm = TRUE
    ),
    dialysis_postop = (!is.na(`Post-Op-Renal-Dialysis Req`) &
                         `Post-Op-Renal-Dialysis Req` == "Yes"),
    PRF = case_when(
      dialysis_postop                                              ~ 1L,
      !is.na(creatinine_postop) & !is.na(creatinine_baseline) &
        creatinine_postop >= 2.0 * creatinine_baseline            ~ 1L,
      is.na(creatinine_postop) & !dialysis_postop                 ~ NA_integer_,
      TRUE                                                         ~ 0L
    )
  ) %>%
  select(
    -`Peak Postoperative Creatinine Level within 48 hours of OR Exit`,
    -`Peak Postoperative Creatinine Level prior to discharge`,
    -`Post-Op-Renal-Dialysis Req`,
    -creatinine_postop,
    -dialysis_postop
  )

log_msg(sprintf("PRF=1: %d  |  PRF=0: %d  |  Indeterminate: %d",
                sum(sts$PRF == 1, na.rm = TRUE),
                sum(sts$PRF == 0, na.rm = TRUE),
                sum(is.na(sts$PRF))))

n_before <- nrow(sts)
sts <- filter(sts, !is.na(PRF))
log_msg(sprintf("Removed %d indeterminate PRF patients", n_before - nrow(sts)))



# STEP 1 — Exclude patients on preoperative dialysis

n_before <- nrow(sts)
sts <- filter(sts, is.na(`RF-Renal Fail-Dialysis`) |
                !(`RF-Renal Fail-Dialysis` %in% c("Yes", "Unknown")))
log_step(1, "Exclude preop dialysis patients", n_before, nrow(sts))
sts <- select(sts, -`RF-Renal Fail-Dialysis`)

# VAD exclusions (hard exclusions per collaborator)
n_before <- nrow(sts)
sts <- filter(sts, is.na(`VAD-Patient Admitted With VAD`) |
                `VAD-Patient Admitted With VAD` != "Yes")
log_step("VAD-A", "Exclude VAD-admitted patients", n_before, nrow(sts))

n_before <- nrow(sts)
sts <- filter(sts,
              is.na(`Ventricular Assist Device Implanted During This Hospitalization`) |
                `Ventricular Assist Device Implanted During This Hospitalization` != "Yes")
log_step("VAD-I", "Exclude VAD implanted during hospitalisation", n_before, nrow(sts))

sts <- select(sts,
              -`VAD-Patient Admitted With VAD`,
              -`Ventricular Assist Device Implanted During This Hospitalization`)

# Convert "Unknown" to NA for all binary Yes/No comorbidity columns
sts <- sts %>%
  mutate(across(
    where(~is.character(.) && all(na.omit(.) %in% c("Yes", "No", "Unknown"))),
    ~na_if(., "Unknown")
  ))
log_msg(sprintf("Converted 'Unknown' to NA across all binary Yes/No columns"))
# Convert NYHA "Not Documented" to NA
# BUGFIX: the real data contains the value "Not documented" (lowercase "d"),
# but this used to compare against "Not Documented" (capital "D") via na_if(),
# which is case-sensitive -- so the conversion was silently matching 0 rows.
# 2,615 of 3,692 rows (70.8%) were retaining "Not documented" as a live
# category instead of being treated as missing. Fixed to match case-
# insensitively so it catches this value regardless of capitalization.
if ("Classification-NYHA" %in% names(sts)) {
  n_not_doc <- sum(str_to_lower(sts$`Classification-NYHA`) == "not documented", na.rm = TRUE)
  sts <- sts %>%
    mutate(`Classification-NYHA` = if_else(
      str_to_lower(`Classification-NYHA`) == "not documented",
      NA_character_,
      `Classification-NYHA`
    ))
  log_msg(sprintf("Converted %d NYHA 'Not documented'/'Not Documented' values to NA", n_not_doc))
}
n_before <- nrow(sts)
sts <- filter(sts, !flag_emergent_salvage)
log_step("EMERGENT", "Exclude Emergent Salvage patients", n_before, nrow(sts))

# CABG/VALVE INCLUSION FILTER  [NEW — previously missing]
#
# README (Magenta exclusion notes) / email item #4:
#   "For all analyses, only CABG and Valve cases should be used in the
#    analysis. Include iff (column 'CAB' (planned and unplanned)) OR
#    (column 'Valve' is Yes)."
#
# CAB is documented as having planned/unplanned/no-type values rather than a
# strict Yes/No; the filter below treats anything that isn't an explicit "No"
# (case-insensitive) as an included CAB case. The unique-value log lines let
# an analyst confirm the actual coding in this extract before trusting the
# filter — please check this log output against the real data on first run.
log_msg("\n--- CABG/Valve surgery type inclusion filter ---")
log_msg(sprintf("  CAB unique values:   %s",
                paste(unique(sts$CAB), collapse = " | ")))
log_msg(sprintf("  Valve unique values: %s",
                paste(unique(sts$Valve), collapse = " | ")))

n_before <- nrow(sts)
sts <- filter(sts,
              (!is.na(CAB)   & !(str_to_lower(CAB) %in% c("no"))) |
              (!is.na(Valve) & str_to_lower(Valve) == "yes"))
log_step("CABG-VALVE", "Include only CABG (planned/unplanned) or Valve = Yes cases",
         n_before, nrow(sts))

# STEP 2 — Exclude patients with baseline creatinine >= 4 mg/dL

n_before <- nrow(sts)
sts <- filter(sts, is.na(creatinine_baseline) | creatinine_baseline < 4.0)
log_step(2, "Exclude baseline creatinine >= 4 mg/dL", n_before, nrow(sts))

# STEP 3 Drop columns with > 50% missing data

log_msg("\n--- Step 3: Drop columns > 50% missing ---")

miss_rate <- sapply(sts, function(x) mean(is.na(x)))
cols_drop  <- names(miss_rate[miss_rate > 0.50])

for (col in cols_drop)
  log_msg(sprintf("  Dropping: %-55s  (%.1f%% missing)", col, 100 * miss_rate[col]))

sts <- select(sts, -all_of(cols_drop))
log_step(3, sprintf("Dropped %d columns with >50%% missing", length(cols_drop)))



# STEP 4 — Row deletion for low-missingness variables
#           Numeric: <= 1% missing  |  Categorical: <= 2% missing

log_msg("\n--- Step 4: Row deletion for low-missingness variables ---")

EXCLUDE_FROM_MISS_CHECK <- c(
  "New_MRN", "Surgery_Date", "Surgery_Date_parsed",
  "OR Entry Date And Time", "OR Exit Date And Time",
  "PRF", "Race", "BMI", "creatinine_baseline",
  "flag_missing_bp", "flag_emergent_salvage"
)

study_cols     <- setdiff(names(sts), EXCLUDE_FROM_MISS_CHECK)
miss_study     <- sapply(sts[study_cols], function(x) mean(is.na(x)))
is_numeric_col <- sapply(sts[study_cols], is.numeric)

num_row_delete <- names(miss_study[ is_numeric_col & miss_study > 0 & miss_study <= 0.01])
cat_row_delete <- names(miss_study[!is_numeric_col & miss_study > 0 & miss_study <= 0.02])

log_msg(sprintf("  Numeric row-delete   (n=%d): %s",
                length(num_row_delete), paste(num_row_delete, collapse = ", ")))
log_msg(sprintf("  Categorical row-delete (n=%d): %s",
                length(cat_row_delete), paste(cat_row_delete, collapse = ", ")))

n_before <- nrow(sts)
if (length(num_row_delete) > 0)
  sts <- filter(sts, if_all(all_of(num_row_delete), ~!is.na(.)))
if (length(cat_row_delete) > 0)
  sts <- filter(sts, if_all(all_of(cat_row_delete), ~!is.na(.)))
log_step(4, "Row deletion for low-missingness variables", n_before, nrow(sts))

# Report intermediate missingness (>1% numeric, >2% categorical) for analyst review
mid_miss <- miss_study[
  (is_numeric_col  & miss_study > 0.01 & miss_study <= 0.50) |
  (!is_numeric_col & miss_study > 0.02 & miss_study <= 0.50)
]
if (length(mid_miss) > 0) {
  log_msg("  NOTE — intermediate missingness (no approved handling yet):")
  for (col in names(mid_miss))
    log_msg(sprintf("    %-45s  %.2f%%", col, 100 * mid_miss[col]))
}



# STEP 5 — Deduplicate: keep most recent surgery per patient

n_before <- nrow(sts)
sts <- sts %>%
  arrange(New_MRN, desc(Surgery_Date_parsed)) %>%
  distinct(New_MRN, .keep_all = TRUE)
log_step(5, "Deduplicate: kept most recent surgery per New_MRN", n_before, nrow(sts))



# STEP 6 — Drop near-zero-variance categorical columns (< 1% positive cases)

log_msg("\n--- Step 6: Near-zero-variance categorical columns ---")

nzv_check_cols <- names(sts)[sapply(sts, function(x) {
  is.character(x) && all(na.omit(x) %in% c("Yes", "No", "Unknown"))
})]

nzv_drop <- character()
for (col in nzv_check_cols) {
  pct_yes <- mean(sts[[col]] == "Yes", na.rm = TRUE)
  log_msg(sprintf("  %-45s  %.2f%% Yes", col, 100 * pct_yes))
  if (pct_yes < 0.01) nzv_drop <- c(nzv_drop, col)
}

if (length(nzv_drop) > 0) {
  sts <- select(sts, -all_of(nzv_drop))
  log_step(6, sprintf("Dropped %d NZV columns: %s",
                      length(nzv_drop), paste(nzv_drop, collapse = ", ")))
} else {
  log_step(6, "No columns below 1% positive threshold")
}



# STEP 7 — Combine chronic lung disease severity + type into one variable

log_msg("\n--- Step 7: Combine CLD severity + type ---")

sts <- sts %>%
  mutate(
    CLD_Severity = case_when(
      `RF-Chronic Lung Disease` == "No"                                  ~ "No",
      `RF-Chronic Lung Disease` == "Mild"                                ~ "Mild",
      `RF-Chronic Lung Disease` == "Moderate"                            ~ "Moderate",
      `RF-Chronic Lung Disease` == "Severe"                              ~ "Severe",
      str_detect(str_to_lower(`RF-Chronic Lung Disease`), "documented")  ~ "Documented_UnknownSeverity",
      `RF-Chronic Lung Disease` == "Unknown"                             ~ "Unknown",
      TRUE                                                                ~ NA_character_
    ),
    # Guard: Type column may have been dropped by Step 3 (>50% missing)
    CLD_Type = if ("RF-Chronic Lung Disease - Type" %in% names(.)) {
      case_when(
        is.na(`RF-Chronic Lung Disease - Type`) |
          `RF-Chronic Lung Disease - Type` == "Not Documented" ~ "Unknown",
        TRUE ~ `RF-Chronic Lung Disease - Type`
      )
    } else {
      "Unknown"
    },
    CLD_Combined = case_when(
      CLD_Severity == "No"  ~ "No",
      is.na(CLD_Severity)   ~ NA_character_,
      TRUE                  ~ paste0(CLD_Severity, "_", CLD_Type)
    )
  ) %>%
  select(-`RF-Chronic Lung Disease`,
         -any_of("RF-Chronic Lung Disease - Type"),
         -CLD_Severity, -CLD_Type)

log_step(7, "CLD_Combined created from severity + type; source columns removed")
cat(capture.output(sort(table(sts$CLD_Combined, useNA = "always"),
                        decreasing = TRUE)), sep = "\n")

n_cld_unk <- sum(sts$CLD_Combined %in%
                   c("Unknown_Unknown", "Documented_UnknownSeverity_Unknown"),
                 na.rm = TRUE)
# Exclude patients with undocumentable CLD status
# Unknown_Unknown = both severity and type unknown — not a valid clinical category
# Documented_UnknownSeverity_Unknown = disease documented but neither severity
#   nor type recorded — insufficient information for clinical use
n_before <- nrow(sts)
sts <- sts %>%
  filter(!CLD_Combined %in% c("Unknown_Unknown",
                              "Documented_UnknownSeverity_Unknown") |
           is.na(CLD_Combined))
log_step("EXCL-CLD", "Exclude Unknown/Unknown CLD_Combined patients",
