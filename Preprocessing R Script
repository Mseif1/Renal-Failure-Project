# BP PHASE LABELING  [CORRECTED — bp_id is authoritative]
#
# CONFIRMED by collaborator: bp_id has 3 levels, and the mapping to phase is
# definitive, not inferred:
#   ANES_BP      -> Intraoperative (OR)
#   SBP&DBP_Art  -> Postoperative (arterial line)
#   MAP_BMDI     -> Postoperative (cuff)
#
# This supersedes two earlier (wrong) attempts at phase labeling:
#   1. anchor_src string matching -- anchor_src turned out to just be the
#      timestamp REFERENCE POINT used to compute hours_from_start, not the
#      clinical phase, and produced ZERO patient overlap between intraop and
#      postop (158 postop patients total), which was never plausible.
#   2. hours_from_start vs. surgery-duration heuristic -- a reasonable proxy
#      (gave ~2,642 postop / ~2,637 overlap) but still an approximation.
#
# bp_id gives a direct, authoritative phase label with no timestamp math
# needed. Sanity check: median hours_from_start is ~3h for ANES_BP (fits
# intraop), ~18.5h for SBP&DBP_Art, and ~31h for MAP_BMDI (both fit postop).
# Under this definition: 2,488 patients have intraop BP, 2,642 have postop
# BP, and 2,484 have BOTH -- so intraop_postop / preop_intraop_postop are
# now well-populated cases rather than empty ones.

log_msg("Deriving BP phase directly from bp_id (confirmed authoritative by collaborator)")
if ("bp_id" %in% names(bp)) {
  log_msg(sprintf("  bp_id unique values: %s", paste(unique(bp$bp_id), collapse = " | ")))

  bp <- bp %>%
    mutate(
      bp_phase = case_when(
        bp_id == "ANES_BP"                    ~ "Intraoperative",
        bp_id %in% c("SBP&DBP_Art", "MAP_BMDI") ~ "Postoperative",
        TRUE                                   ~ "Unknown"
      )
    )

  n_unmapped <- sum(bp$bp_phase == "Unknown")
  if (n_unmapped > 0)
    log_msg(sprintf(
      "  WARNING: %d BP rows have a bp_id value not in {ANES_BP, SBP&DBP_Art, MAP_BMDI} -> labeled 'Unknown' and excluded from both phases.",
      n_unmapped))

} else {
  # Fallback only if bp_id is absent from a future extract.
  log_msg("  WARNING: 'bp_id' column not found in this BP file -- falling back to")
  log_msg("  hours_from_start vs. surgery-duration heuristic. Confirm with collaborator.")

  or_times <- sts %>%
    select(New_MRN, Surgery_Date_parsed,
           OR_entry_str = `OR Entry Date And Time`,
           OR_exit_str  = `OR Exit Date And Time`) %>%
    mutate(
      OR_entry = coalesce(
        suppressWarnings(mdy_hms(OR_entry_str, quiet = TRUE)),
        suppressWarnings(mdy_hm(OR_entry_str,  quiet = TRUE))
      ),
      OR_exit = coalesce(
        suppressWarnings(mdy_hms(OR_exit_str, quiet = TRUE)),
        suppressWarnings(mdy_hm(OR_exit_str,  quiet = TRUE))
      ),
      surgery_duration_hrs = as.numeric(difftime(OR_exit, OR_entry, units = "hours"))
    ) %>%
    select(New_MRN, Surgery_Date_parsed, surgery_duration_hrs)

  bp <- left_join(bp, or_times, by = c("New_MRN", "Surgery_Date_parsed")) %>%
    mutate(
      bp_phase = case_when(
        !is.na(surgery_duration_hrs) &
          hours_from_start <= surgery_duration_hrs  ~ "Intraoperative",
        !is.na(surgery_duration_hrs) &
          hours_from_start >  surgery_duration_hrs  ~ "Postoperative",
        is.na(surgery_duration_hrs) &
          hours_from_start <= 6                     ~ "Intraoperative",
        is.na(surgery_duration_hrs) &
          hours_from_start >  6                     ~ "Postoperative",
        TRUE                                        ~ "Unknown"
      )
    )
}

