    "\nNOTE: %d of %d case(s) SKIPPED for the rest of the pipeline due to insufficient data: %s",
    length(skipped), length(ALL_CASES), paste(skipped, collapse = ", ")))
  log_msg("      These cases are not modelable with the current cohort as filtered.")
  log_msg("      Discuss with the collaborator whether the BP-overlap requirement,")
  log_msg("      CABG/Valve filter, or missingness exclusions need revisiting for them.")
}



# PIPELINE FUNCTION — Steps 14–17
# Applied separately to each of the three dataset splits.
# Step 14: RUS at 10:1 neg:pos ratio on training set
# Step 15: Z-score normalisation (fit on post-RUS train; applied to test)
# Step 16: SMOTE-NC (k=5) — doubles the minority class (Mickey constraint)
# Step 17: k-1 dummy encoding of all categorical variables

apply_pipeline_steps_14_to_17 <- function(train_raw, test_raw, dataset_name) {

  log_msg(sprintf("\n=== Pipeline Steps 14-17: %s ===", dataset_name))

  # ML training uses the log-transformed Platelet Count only (matches the
  # originally-approved Step 10 behavior). Raw Platelet Count is kept
  # upstream for statistics/correlation use but is not an ML feature -- drop
  # it here if present, so downstream scaling/SMOTE/encoding never sees it.
  if ("Platelet Count" %in% names(train_raw)) {
    train_raw <- select(train_raw, -`Platelet Count`)
    test_raw  <- select(test_raw,  -`Platelet Count`)
  }

  # Columns excluded from scaling and encoding
  ID_COLS   <- c("New_MRN", "Surgery_Date", "Surgery_Date_parsed",
                 "OR Entry Date And Time", "OR Exit Date And Time")
  FLAG_COLS <- c("flag_missing_bp", "flag_emergent_salvage")
  OUTCOME   <- "PRF"
  SKIP_COLS <- c(ID_COLS, FLAG_COLS, OUTCOME)

  # STEP 14: RUS
  # Target: 70:30 negative:positive AFTER SMOTE-NC doubles the minority class.
  # the required neg count before SMOTE-NC is:
  #   n_neg_target / (2 * n_pos) = 70/30
  #   n_neg_target = (14/3) * n_pos ≈ 4.67 * n_pos
  
  n_pos        <- sum(train_raw$PRF == 1)
  n_neg        <- sum(train_raw$PRF == 0)
  n_neg_target <- min(n_neg, round(n_pos * (14 / 3)))
  
  train_pos <- filter(train_raw, PRF == 1)
  train_neg <- slice_sample(filter(train_raw, PRF == 0),
                            n = n_neg_target, replace = FALSE)
  train_rus <- slice_sample(bind_rows(train_pos, train_neg), prop = 1)
  
  log_step(14, sprintf(
    "RUS: %d pos + %d neg = %d rows | neg:pos = %.1f:1 (targeting 70:30 post-SMOTE-NC)",
    n_pos, n_neg_target, nrow(train_rus), n_neg_target / n_pos
  ))
  # STEP 15: Z-score normalisation
  # Fit on post-RUS training set; apply same parameters to test set.
  num_cols_to_scale <- names(train_rus)[
    sapply(train_rus, is.numeric) & !names(train_rus) %in% SKIP_COLS
  ]
  scaler  <- preProcess(train_rus[num_cols_to_scale], method = c("center", "scale"))
  train_z <- train_rus
  test_z  <- test_raw
  train_z[num_cols_to_scale] <- predict(scaler, train_rus[num_cols_to_scale])
  test_z[num_cols_to_scale]  <- predict(scaler, test_raw[num_cols_to_scale])

  log_step(15, sprintf("Z-score normalisation: %d columns (train params applied to test)",
                       length(num_cols_to_scale)))

  # Pre-SMOTE-NC imputation
  # SMOTE-NC requires complete data. Remaining NAs (intermediate missingness
  # not handled by Steps 3-4) are imputed here using training set statistics.
  # Same imputation values are applied to the test set.
  num_na_cols <- names(train_z)[
    sapply(train_z, is.numeric) &
    sapply(train_z, function(x) any(is.na(x))) &
    !names(train_z) %in% SKIP_COLS
  ]
  cat_na_cols <- names(train_z)[
    (sapply(train_z, is.character) | sapply(train_z, is.logical)) &
    sapply(train_z, function(x) any(is.na(x))) &
    !names(train_z) %in% SKIP_COLS
  ]

  impute_medians <- sapply(train_z[num_na_cols], median, na.rm = TRUE)
  impute_modes   <- sapply(train_z[cat_na_cols], function(x) {
    tbl <- table(x, useNA = "no")
    names(tbl)[which.max(tbl)]
  })

  for (col in num_na_cols) {
    train_z[[col]][is.na(train_z[[col]])] <- impute_medians[[col]]
    test_z[[col]][is.na(test_z[[col]])]   <- impute_medians[[col]]
  }
  for (col in cat_na_cols) {
    train_z[[col]][is.na(train_z[[col]])] <- impute_modes[[col]]
    test_z[[col]][is.na(test_z[[col]])]   <- impute_modes[[col]]
  }

  if (length(num_na_cols) + length(cat_na_cols) > 0) {
    log_msg(sprintf("  Pre-SMOTE-NC imputation: %d numeric (median) + %d categorical (mode)",
                    length(num_na_cols), length(cat_na_cols)))
    if (length(num_na_cols) > 0)
      log_msg(sprintf("    Numeric columns imputed (median): %s",
                      paste(num_na_cols, collapse = ", ")))
    if (length(cat_na_cols) > 0)
      log_msg(sprintf("    Categorical columns imputed (mode): %s",
                      paste(cat_na_cols, collapse = ", ")))
  }

  # STEP 16: SMOTE-NC — double the minority class
  # over_ratio = target_minority / majority = (2 * n_pos) / n_neg
  # This doubles the number of PRF cases (Mickey's approved constraint).
  # SMOTE-NC handles mixed data: interpolates continuous, copies categorical.
  # Applied BEFORE dummy encoding so categorical columns are still factors.
  n_pos_rus        <- sum(train_z$PRF == 1)
  n_neg_rus        <- sum(train_z$PRF == 0)
  over_ratio_target <- (2 * n_pos_rus) / n_neg_rus

  log_msg(sprintf("  SMOTE-NC: n_pos=%d | n_neg=%d | over_ratio=%.4f (2x minority)",
                  n_pos_rus, n_neg_rus, over_ratio_target))

  cat_cols_for_smote <- names(train_z)[
    (sapply(train_z, is.character) | sapply(train_z, is.logical)) &
      !names(train_z) %in% SKIP_COLS
  ]

  # SMOTE-NC needs at least k+1 minority-class rows (it interpolates between
  # each minority point and its k nearest minority neighbors). Cap k to what's
  # actually available in this case's training set instead of hardcoding 5,
  # and skip SMOTE entirely if there isn't even 1 neighbor to interpolate with.
  k_smote <- min(5, n_pos_rus - 1)

  if (k_smote < 1) {
    log_msg(sprintf(
      "  SKIPPING SMOTE-NC: only %d minority (PRF=1) row(s) in training set -- need at least 2. Training set left un-oversampled.",
      n_pos_rus))
    train_smoted <- train_z %>%
      mutate(across(all_of(cat_cols_for_smote), as.factor))
  } else {
    if (k_smote < 5)
      log_msg(sprintf("  NOTE: reducing SMOTE-NC k from 5 to %d (only %d minority rows available)",
                      k_smote, n_pos_rus))

    # Hard safety net: even with k capped to the available minority count,
    # themis::smotenc() can still throw "Not enough observations of `1`"
    # (e.g. if a resampled fold or a categorical level leaves too few usable
    # neighbors internally). Catch it here so one small case can't abort the
    # whole 3-case pipeline -- fall back to un-oversampled training data.
    train_smoted <- tryCatch({
      train_z %>%
        mutate(across(all_of(cat_cols_for_smote), as.factor),
               PRF = as.factor(PRF)) %>%
        smotenc(var = "PRF", k = k_smote, over_ratio = over_ratio_target) %>%
        mutate(PRF = as.integer(as.character(PRF)))
    }, error = function(e) {
      log_msg(sprintf(
        "  SMOTE-NC FAILED (%s) -- leaving this case's training set un-oversampled.",
        conditionMessage(e)))
      train_z %>% mutate(across(all_of(cat_cols_for_smote), as.factor))
    })
  }

  log_step(16, sprintf("SMOTE-NC: %d -> %d rows | PRF=%.2f%% | minority: %d -> %d",
                       nrow(train_z), nrow(train_smoted),
                       100 * mean(train_smoted$PRF),
                       n_pos_rus, sum(train_smoted$PRF)))

  # STEP 17: k-1 dummy encoding
  # Remove SKIP_COLS before encoding; re-attach PRF after.
  skip_train <- SKIP_COLS[SKIP_COLS %in% names(train_smoted)]
  skip_test  <- SKIP_COLS[SKIP_COLS %in% names(test_z)]

  train_prf  <- train_smoted[["PRF"]]
  test_prf   <- test_z[["PRF"]]

  train_feat <- train_smoted[, !names(train_smoted) %in% c(skip_train, "PRF"), drop = FALSE]
  test_feat  <- test_z[,      !names(test_z)        %in% c(skip_test,  "PRF"), drop = FALSE]

  for (col in names(train_feat)[sapply(train_feat, is.character)])
    train_feat[[col]] <- as.factor(train_feat[[col]])
  for (col in names(test_feat)[sapply(test_feat, is.character)])
    test_feat[[col]]  <- as.factor(test_feat[[col]])

  train_factor_cols <- names(train_feat)[sapply(train_feat, is.factor)]
  test_factor_cols  <- names(test_feat)[sapply(test_feat, is.factor)]

  if (length(train_factor_cols) > 0) {
    train_enc <- dummy_cols(train_feat,
                            select_columns          = train_factor_cols,
                            remove_first_dummy      = TRUE,
                            remove_selected_columns = TRUE)
  } else {
    train_enc <- train_feat
  }

  if (length(test_factor_cols) > 0) {
    test_enc  <- dummy_cols(test_feat,
                            select_columns          = test_factor_cols,
                            remove_first_dummy      = TRUE,
                            remove_selected_columns = TRUE)
  } else {
    test_enc <- test_feat
  }

  # Add any dummy columns present in train but absent from test (rare category levels)
  for (col in setdiff(names(train_enc), names(test_enc)))
    test_enc[[col]] <- 0L
  test_enc <- test_enc[, names(train_enc), drop = FALSE]

  log_step(17, sprintf("k-1 dummy encoding: %d features", ncol(train_enc)))

  # Attach PRF label as last column
  train_final <- cbind(train_enc, PRF = train_prf)
  test_final  <- cbind(test_enc,  PRF = test_prf)
  rownames(train_final) <- NULL
  rownames(test_final)  <- NULL

  log_msg(sprintf("  Test PRF: %d events / %d total (%.2f%%)",
                  sum(test_final$PRF), nrow(test_final), 100*mean(test_final$PRF)))
  log_step("DONE", sprintf("train: %d rows x %d cols | test: %d rows x %d cols",
                           nrow(train_final), ncol(train_final),
                           nrow(test_final),  ncol(test_final)))

  list(train = train_final, test = test_final, scaler = scaler)

}  # end apply_pipeline_steps_14_to_17



