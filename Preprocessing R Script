# Log helpers
LOG <- character()
log_msg <- function(...) {
  msg <- paste0(...)
  cat(msg, "\n")
  LOG <<- c(LOG, msg)
}
log_step <- function(step, desc, n_before = NULL, n_after = NULL) {
  if (!is.null(n_before) && !is.null(n_after))
    log_msg(sprintf("[Step %s] %s  |  rows: %d -> %d (removed %d)",
                    step, desc, n_before, n_after, n_before - n_after))
  else
    log_msg(sprintf("[Step %s] %s", step, desc))
}

log_msg("=== PRF Preprocessing Pipeline — Steps 1-17 ===")
log_msg(paste("Timestamp:", format(Sys.time())))



# 1. LOAD DATA

