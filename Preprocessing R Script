# 2. BMI IMPUTATION (must run on sts_raw before column selection)
log_msg("\n--- BMI imputation ---")

n_bmi_missing <- sum(is.na(sts_raw$`Calculated BMI`))
sts_raw <- sts_raw %>%
  mutate(
    BMI = case_when(
      !is.na(`Calculated BMI`)                        ~ `Calculated BMI`,
      !is.na(`Weight (kg)`) & !is.na(`Height (cm)`)
        & `Height (cm)` > 0                           ~ `Weight (kg)` /
                                                          (`Height (cm)` / 100)^2,
      TRUE                                             ~ NA_real_
    )
  )

log_msg(sprintf("BMI: %d missing -> imputed %d from height/weight -> %d still missing",
                n_bmi_missing,
                n_bmi_missing - sum(is.na(sts_raw$BMI)),
                sum(is.na(sts_raw$BMI))))



