read_feature_ranking <- function(case, model) {
  csv_path <- file.path(MASTER_DIRS[[case]], model, CSV_NAMES[[case]])
  if (!file.exists(csv_path)) {
    warning(sprintf("Table 3: feature ranking CSV not found for case='%s', model='%s':\n  %s",
                    case, model, csv_path))
    return(NULL)
  }
  raw <- read.csv(csv_path, row.names = 1, stringsAsFactors = FALSE)
  raw %>% rename(importance = numeric_val, feature = feature_names) %>% arrange(desc(importance))
}

encode_raw_data <- function(raw_path) {
  if (!file.exists(raw_path)) {
    warning(sprintf("Table 3: raw patient CSV not found: %s", raw_path))
    return(NULL)
  }
  df <- read.csv(raw_path, stringsAsFactors = FALSE, check.names = FALSE)
  df$PRF_bin <- ifelse(df$PRF == "PRF", 1, 0)
  if ("Platelet Count" %in% names(df) && !"Platelet_Count_log" %in% names(df))
    df$Platelet_Count_log <- log(df[["Platelet Count"]])
  cat_cols <- setdiff(names(df)[sapply(df, is.character)], "PRF")
  if (length(cat_cols) > 0)
    df <- dummy_cols(df, select_columns = cat_cols, remove_selected_columns = TRUE, ignore_na = TRUE)
  df
}

get_correlations <- function(encoded_df, features) {
  out <- data.frame(feature = features, corr = NA_real_, pval = NA_real_)
  missing <- character(0)
  for (i in seq_along(features)) {
    f <- features[i]
    if (f %in% names(encoded_df)) {
      x <- suppressWarnings(as.numeric(encoded_df[[f]]))
      test <- tryCatch(
        cor.test(x, encoded_df$PRF_bin, method = "spearman", exact = FALSE),
        error = function(e) NULL
      )
      if (!is.null(test)) { out$corr[i] <- round(unname(test$estimate), 3); out$pval[i] <- test$p.value }
    } else {
      missing <- c(missing, f)
    }
  }
  if (length(missing) > 0)
    warning(sprintf("Table 3: %d feature(s) had no matching column (left blank): %s",
                    length(missing), paste(missing, collapse = ", ")))
  out
}

fmt_p <- function(p) if (is.na(p)) "\u2014" else if (p < 0.001) "<0.001" else sprintf("%.3f", p)

table3_rows <- list()
for (case in names(PERF_SOURCE_FILES)) {
  picks <- MANUSCRIPT_MODEL_SELECTION[[case]]
  encoded <- encode_raw_data(RAW_DATA_FILES[[case]])
  for (pick in picks) {
    ranking <- read_feature_ranking(case, pick$model)
    if (is.null(ranking) || is.null(encoded)) next
    top_n <- head(ranking, FEATURES_SHOWN)
    top_n$Included <- ifelse(seq_len(nrow(top_n)) <= pick$k, "X", "")
    top_n$PercentRank <- round(top_n$importance / top_n$importance[1] * 100, 1)
    corrs <- get_correlations(encoded, top_n$feature)
    section_label <- if (length(picks) > 1)
      sprintf("%s \u2014 %s (k=%d)", case, pick$model, pick$k)
    else
      sprintf("%s (optimum model: %s, k=%d)", case, pick$model, pick$k)
    table3_rows[[section_label]] <- data.frame(
      Section     = section_label,
      Included    = top_n$Included,
      Feature     = top_n$feature,
      RankValue   = round(top_n$importance, 2),
      PercentRank = sprintf("%.1f%%", top_n$PercentRank),
      CorrValue   = corrs$corr,
      CorrP       = sapply(corrs$pval, fmt_p),
      stringsAsFactors = FALSE
    )
  }
}

