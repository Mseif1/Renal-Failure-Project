build_table1 <- function(df, dataset_label, table_number) {
  cat(sprintf("  Building Table %d: %s\n", table_number, dataset_label))

  relabel_cld <- function(x) {
    vapply(as.character(x), function(v) {
      if (is.na(v)) return(NA_character_)
      if (v == "No") return("No")
      parts <- strsplit(v, "_")[[1]]
      if (parts[1] == "Documented" && length(parts) > 1 && parts[2] == "UnknownSeverity") {
        severity_lab <- "Severity Not Documented"
        type_raw <- paste(parts[-(1:2)], collapse = "_")
      } else {
        severity_lab <- ifelse(parts[1] == "Unknown", "Severity Not Documented", parts[1])
        type_raw <- paste(parts[-1], collapse = "_")
      }
      type_lab <- if (type_raw == "Unknown" || type_raw == "") {
        "Type Not Documented"
      } else {
        paste("Type:", gsub("_", " ", type_raw))
      }
      paste0(severity_lab, ", ", type_lab)
    }, character(1), USE.NAMES = FALSE)
  }

  df <- df %>%
    select(-any_of(DROP_COLS)) %>%
    mutate(
      PRF = factor(PRF, levels = c(0, 1), labels = c("No PRF", "PRF")),
      across(where(is.character), as.factor)
    )

  if ("CLD_Combined" %in% names(df)) {
    df <- df %>%
      mutate(CLD_Combined = factor(relabel_cld(CLD_Combined))) %>%
     
      mutate(CLD_Combined = forcats::fct_relevel(CLD_Combined, "No"))
  }

  df <- df %>%
    mutate(across(
      where(~is.factor(.) && any(grepl("_", levels(.)))),
      ~factor(., levels = levels(.), labels = gsub("_", " ", levels(.)))
    ))

  df <- df %>%
    mutate(across(
      where(is.factor) & !any_of("CLD_Combined"),
      ~ factor(dplyr::na_if(as.character(.), "Unknown"))
    ))

  existing_labels <- VAR_LABELS[names(VAR_LABELS) %in% names(df)]

  bp_cols <- names(df)[grepl("^(Intraop|Postop)_(MAP|SBP)_", names(df)) &
                       !names(df) %in% names(existing_labels)]
  if (length(bp_cols) > 0) {
    bp_labels <- setNames(lapply(bp_cols, bp_feature_label), bp_cols)
    bp_labels <- bp_labels[!sapply(bp_labels, is.na)]
    unresolved <- setdiff(bp_cols, names(bp_labels))
    if (length(unresolved) > 0)
      cat(sprintf("  WARNING: could not auto-generate a label for: %s (falling back to raw column name)\n",
                  paste(unresolved, collapse = ", ")))
    existing_labels <- c(existing_labels, bp_labels)
  }

  var_label(df) <- existing_labels

  num_cols <- names(df)[sapply(df, is.numeric) & names(df) != "PRF"]
  cat_cols  <- names(df)[sapply(df, function(x) is.factor(x)|is.character(x)) &
                           names(df) != "PRF"]

  tbl <- df %>%
    tbl_summary(
      by           = PRF,
      missing      = "no",
      type         = list(all_of(num_cols) ~ "continuous",
                          all_of(cat_cols) ~ "categorical"),
      statistic    = list(
        # Matches Weaver format: "Median (IQR)" and "n (%)"
        all_continuous()  ~ "{median} ({p25}, {p75})",
        all_categorical() ~ "{n} ({p}%)"
      ),
      digits = list(
        all_continuous()  ~ 2,
        all_categorical() ~ c(0, 1)
      )
    ) %>%
    add_p(
      test = list(
        all_continuous()  ~ "wilcox.test",
        all_categorical() ~ "chisq.test"
      ),
      pvalue_fun = function(x) {
        ifelse(is.na(x), NA_character_,
          ifelse(x < 0.001, "<0.001",
                 sprintf("%.3f", x)))
      }
    ) %>%
    add_overall(last = FALSE) %>%
    add_n() %>%
    bold_p(t = 0.05) %>%
    bold_labels() %>%
    modify_header(
      label   ~ "**Characteristic**",
      stat_0  ~ "**Overall**  \nN = {N}",
      stat_1  ~ "**No PRF**  \nN = {n}",
      stat_2  ~ "**PRF**  \nN = {n}",
      p.value ~ "**p-value**"
    )

  caption_text <- sprintf(
    "Patient and clinical characteristics for the %s dataset, by postoperative renal failure (PRF) status.",
    dataset_label
  )

  list(tbl = tbl, caption = caption_text)
}

