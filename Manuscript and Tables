COL_NAVY   <- "#1B3A6B"   # consistent with lab's existing colour scheme

b_thick <- officer::fp_border(color = "black", width = 1.5)
b_thin  <- officer::fp_border(color = "black", width = 0.75)
b_none  <- officer::fp_border(width = 0)

style_journal_table <- function(ft) {
  ft %>%
    font(fontname = FONT_NAME, part = "all") %>%
    fontsize(size = FONT_SIZE, part = "all") %>%
    bold(part = "header") %>%
    color(color = "black", part = "all") %>%
    border_remove() %>%
    hline_top(border = b_thick, part = "header") %>%
    hline_bottom(border = b_thin,  part = "header") %>%
    hline_bottom(border = b_thick, part = "body") %>%
    # Left-align characteristic column; centre all other columns
    align(j = 1, align = "left",   part = "all") %>%
    align(j = -1, align = "center", part = "all") %>%
    padding(padding.top = 2, padding.bottom = 2, part = "all") %>%
    set_table_properties(layout = "autofit", width = 1)
}



