fmt_metric <- function(x) if (is.null(x) || is.na(x)) "\u2014" else sprintf("%.3f", x)
fmt_metric_ci <- function(mid, lo, hi) {
  if (is.null(mid) || is.na(mid)) return("\u2014")
  if (is.null(lo) || is.na(lo) || is.null(hi) || is.na(hi))
    return(sprintf("%.2f", mid))
  sprintf("%.2f (%.2f\u2013%.2f)", mid, lo, hi)
}

# MANUSCRIPT MODEL SELECTION -- curated by reviewer (DG), NOT automatic.
# Each case lists a single final model/k pick (Table 3 below shows its
# feature ranking).
# k is NOT capped at K_CAP here -- these are hand-picked from the full
# FeatureNumber range (see e.g. avNNet/MAPonly, whose best Test AUROC is at
# k=24, outside the old k<=20 cap).
#
# All 8 cases are now finalized to a single model/k each; comparisons for
# Preop+Intraop+Postop (naive_bayes vs rf), Preop+Intraop MAP-only (avNNet
# vs rf), and Intraop+Postop (naive_bayes vs its nearest competitors) were
# resolved in favor of the fewer-feature model in every case where the
# performance uplift from more features was small and/or unstable across k.
MANUSCRIPT_MODEL_SELECTION <- list(
  Preoperative                  = list(list(model = "rf",          k = 18)),
  Intraoperative                 = list(list(model = "glmboost",     k = 6)),
  Postoperative                   = list(list(model = "rf",          k = 8,
                                              caveat = "No model for this case reached acceptable Test PRAUC; reported for completeness only.")),
  `Preop + Intraop`               = list(list(model = "rf",          k = 11)),
  `Preop + Postop`                 = list(list(model = "glm",        k = 7,
                                              caveat = "Train-Test gap is a little large but judged manageable).")),
  `Intraop + Postop`               = list(list(model = "naive_bayes", k = 2,
                                              caveat = "Best raw Test AUROC of all 13 models")),
  `Preop + Intraop + Postop`       = list(
                                        list(model = "naive_bayes", k = 3,
                                             caveat = "Xompetitive with fewer features than rf.")
                                      ),
  `Preop + Intraop (MAP only)`     = list(
                                        list(model = "rf",          k = 12,
                                             caveat = "Preferred over avNNet, avNNet's small Test AUROC edge (+0.008) needs 2x the features on a noisy, unstable curve; rf is flat/consistent from k~9 onward.")
                                      )
)

get_row_for_model <- function(path, case_label, model, k) {
  if (!file.exists(path)) {
    warning(sprintf("Table 2: file not found for '%s' (%s) -- reporting as unavailable.",
                    case_label, path))
    return(NULL)
  }
  df <- readxl::read_excel(path, sheet = "Base Learners")
  match_row <- df[df$ModelName == model & df$FeatureNumber == k, ]
  if (nrow(match_row) == 0) {
    warning(sprintf("Table 2: no row found for '%s' model='%s' k=%d -- reporting as unavailable.",
                    case_label, model, k))
    return(NULL)
  }
  match_row[1, ]
}

perf_rows <- list()
for (case_label in names(PERF_SOURCE_FILES)) {
  picks <- MANUSCRIPT_MODEL_SELECTION[[case_label]]
  for (pick in picks) {
    row_key <- if (length(picks) > 1) sprintf("%s | %s", case_label, pick$model) else case_label
    top <- get_row_for_model(PERF_SOURCE_FILES[[case_label]], case_label, pick$model, pick$k)
    if (is.null(top)) {
      perf_rows[[row_key]] <- list(
        Dataset = case_label, Model = sprintf("%s (k=%d, unavailable)", pick$model, pick$k),
        Caveat = pick$caveat,
        Train = list(AUROC = NA, AUROC_lo = NA, AUROC_hi = NA,
                    PRAUC = NA, PRAUC_lo = NA, PRAUC_hi = NA,
                    F1 = NA, F1_lo = NA, F1_hi = NA),
        Test  = list(AUROC = NA, PRAUC = NA, F1 = NA)
      )
      next
    }
    perf_rows[[row_key]] <- list(
      Dataset = case_label,
      Model   = sprintf("%s (k=%d)", top$ModelName, top$FeatureNumber),
      Caveat  = pick$caveat,
      Train = list(
        AUROC = top$Train_AUC,
        AUROC_lo = top$Train_AUC_DeLong_95CI_Lower, AUROC_hi = top$Train_AUC_DeLong_95CI_Upper,
        PRAUC = top$Train_PRAUC_Boot_Mid,
        PRAUC_lo = top$Train_PRAUC_95BootCI_Lower, PRAUC_hi = top$Train_PRAUC_95BootCI_Upper,
        F1    = top$Train_F1_Max_Boot_Mid,
        F1_lo = top$Train_F1_Max_95BootCI_Lower, F1_hi = top$Train_F1_Max_95BootCI_Upper
      ),
      Test  = list(AUROC = top$Test_AUC, PRAUC = top$Test_PRAUC, F1 = top$Test_F1_Max)
    )
  }
}

