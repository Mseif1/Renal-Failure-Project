# Variable labels
bp_feature_label <- function(colname) {
  m <- regmatches(colname, regexec("^(Intraop|Postop)_(MAP|SBP)_(.+)$", colname))[[1]]
  if (length(m) == 0) return(NA_character_)
  phase  <- if (m[2] == "Intraop") "Intraoperative" else "Postoperative"
  metric <- m[3]  # "MAP" or "SBP" -- kept as the acronym; caption defines it
  suffix <- m[4]

  label <- switch(suffix,
    "Mean"        = sprintf("Average %s %s", phase, metric),
    "Median"      = sprintf("Median %s %s", phase, metric),
    "SD"          = sprintf("%s %s Standard Deviation", phase, metric),
    "Min"         = sprintf("Minimum %s %s", phase, metric),
    "Max"         = sprintf("Maximum %s %s", phase, metric),
    "Range"       = sprintf("%s %s Range", phase, metric),
    "Q1"          = sprintf("%s %s, 25th Percentile", phase, metric),
    "Q3"          = sprintf("%s %s, 75th Percentile", phase, metric),
    "IQR"         = sprintf("%s %s Interquartile Range", phase, metric),
    "ARV"         = sprintf("%s %s Average Real Variability", phase, metric),
    "Rate_Max"    = sprintf("Maximum Rate of Change in %s %s (per successive reading)", phase, metric),
    "Rate_Min"    = sprintf("Minimum Rate of Change in %s %s (per successive reading)", phase, metric),
    "Rate_Median" = sprintf("Median Rate of Change in %s %s (per successive reading)", phase, metric),
    "Rate_SD"     = sprintf("Standard Deviation of Rate of Change in %s %s (per successive reading)", phase, metric),
    NA_character_
  )
  if (!is.na(label)) return(label)


  m2 <- regmatches(suffix, regexec("^Pct_(Below|Above|Drop|Spike)_([0-9]+)$", suffix))[[1]]
  if (length(m2) == 0) return(NA_character_)
  direction <- m2[2]; cutoff <- m2[3]
  switch(direction,
    "Below" = sprintf("%% of %s %s Readings Below %s mmHg", phase, metric, cutoff),
    "Above" = sprintf("%% of %s %s Readings Above %s mmHg", phase, metric, cutoff),
    "Drop"  = sprintf("%% of Successive-Reading Drops in %s %s Exceeding %s mmHg", phase, metric, cutoff),
    "Spike" = sprintf("%% of Successive-Reading Increases in %s %s Exceeding %s mmHg", phase, metric, cutoff)
  )
}

