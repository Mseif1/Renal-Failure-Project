# Non-clinical columns to drop before summarising
DROP_FOR_SUMMARY <- c("New_MRN", "Surgery_Date", "Surgery_Date_parsed",
                      "OR Entry Date And Time", "OR Exit Date And Time",
                      "flag_missing_bp", "flag_emergent_salvage",
                      "creatinine_baseline", "has_intraop_bp", "has_postop_bp",
                      # Preprocessing now keeps BOTH raw Platelet Count and
                      # Platelet_Count_log flowing through (log version is
                      # ML-only). Table 1 is real, un-split, un-oversampled
                      # data -- use raw platelet count for readability;
                      # drop the log version here.
                      "Platelet_Count_log")

prepare_for_summary <- function(df, label) {
  df <- df %>%
    select(-any_of(DROP_FOR_SUMMARY)) %>%
    mutate(
      PRF = factor(PRF, levels = c(0, 1), labels = c("No PRF", "PRF")),
      across(where(is.character), as.factor)
    )
  log_info(sprintf("  %-22s %d rows, %d variables", label, nrow(df), ncol(df) - 1))
  df
}

