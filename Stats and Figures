log_write <- function(level, ...) {
  msg <- paste(..., sep = " ")
  line <- sprintf("[%s] %-5s %s", format(Sys.time(), "%Y-%m-%d %H:%M:%S"), level, msg)
  cat(line, "\n", file = LOG_FILE, append = TRUE)
}
