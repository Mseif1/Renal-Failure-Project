log_info("--- Building gtsummary tables ---")

build_summary_table <- function(df, dataset_label, dataset_desc) {
  log_info(sprintf("Building: %s", dataset_label))

  df  <- apply_labels(df)
  num_cols <- names(df)[sapply(df, is.numeric)   & names(df) != "PRF"]
  cat_cols <- names(df)[sapply(df, function(x) is.factor(x) | is.character(x)) &
                           names(df) != "PRF"]

  df %>%
    tbl_summary(
      by           = PRF,
      missing      = "ifany",
      missing_text = "Missing",
      type         = list(all_of(num_cols) ~ "continuous",
                          all_of(cat_cols) ~ "categorical"),
      statistic    = list(all_continuous()  ~ "{median} ({p25}, {p75})",
                          all_categorical() ~ "{n} ({p}%)}"),
      digits       = list(all_continuous()  ~ 2,
                          all_categorical() ~ c(0, 1))
    ) %>%
    add_p(
      test       = list(all_continuous()  ~ "wilcox.test",
                        all_categorical() ~ "chisq.test"),
      pvalue_fun = ~style_pvalue(., digits = 3)
    ) %>%
    add_overall() %>%
    add_n() %>%
    bold_p(t = 0.05) %>%
    bold_labels() %>%
    modify_header(
      label   ~ "**Variable**",
      stat_0  ~ "**Overall**\nN = {N}",
      stat_1  ~ "**No PRF**\nN = {n}",
      stat_2  ~ "**PRF**\nN = {n}",
      p.value ~ "**p-value**"
    ) %>%
    modify_caption(sprintf(
      "**Table 1. Baseline Characteristics by PRF Status — %s Dataset**\n(%s)",
      dataset_label, dataset_desc
    )) %>%
    modify_footnote(
      all_stat_cols() ~
        "Continuous: Median (Q1, Q3). Categorical: n (%). Wilcoxon rank-sum for continuous; Chi-square or Fisher exact for categorical."
    )
}

