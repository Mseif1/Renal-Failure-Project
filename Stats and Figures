# Helper: write one statistics sheet
write_stats_sheet <- function(wb, sheet_name, df, title_text, tab_colour = "1B3A6B") {

  addWorksheet(wb, sheet_name, tabColour = tab_colour)

  writeData(wb, sheet_name, title_text, startRow = 1, startCol = 1)
  addStyle(wb, sheet_name, title_style, rows = 1, cols = 1)

  writeData(wb, sheet_name,
            paste("Statistics on real patient data (pre-oversampling).",
                  "Continuous: Median (Q1, Q3). Categorical: n (%).",
                  "Wilcoxon rank-sum | Chi-square / Fisher exact.",
                  "Bold p < 0.05."),
            startRow = 2, startCol = 1)

  writeData(wb, sheet_name, df,
            startRow = 4, startCol = 1,
            headerStyle = header_style,
            borders = "all", borderStyle = "thin")

  n_rows <- nrow(df)
  n_cols <- ncol(df)

  # Alternating row shading
  for (r in seq(5, 4 + n_rows, by = 2))
    addStyle(wb, sheet_name, even_row_style,
             rows = r, cols = 1:n_cols, stack = TRUE)

  setColWidths(wb, sheet_name, cols = 1,        widths = 45)
  setColWidths(wb, sheet_name, cols = 2:n_cols, widths = 16)
  freezePane(wb,  sheet_name, firstActiveRow = 5, firstActiveCol = 2)

  # Highlight significant p-values
  p_col <- which(names(df) == "p.value")
  if (length(p_col) > 0) {
    for (r in seq_len(n_rows)) {
      p_val <- suppressWarnings(as.numeric(df[[p_col]][r]))
      if (!is.na(p_val) && p_val < 0.05)
        addStyle(wb, sheet_name, sig_style, rows = 4 + r, cols = p_col, stack = TRUE)
    }
  }

  invisible(NULL)
}

