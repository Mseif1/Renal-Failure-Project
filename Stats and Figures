if (length(cases_empty) > 0) {
  log_info(sprintf("Skipped pre-split export for empty case(s): %s", paste(cases_empty, collapse = ", ")))
}

# Sheet names must be <=31 chars and unique -- CASE_INFO labels all qualify
raw_sheets <- setNames(presplit_raw, sapply(cases_nonempty, function(cn) CASE_INFO[[cn]]$label))
enc_sheets <- setNames(presplit_enc, sapply(cases_nonempty, function(cn) CASE_INFO[[cn]]$label))

write_xlsx(raw_sheets, path = "PRF_PreSplit_Raw.xlsx")
log_info(sprintf("Saved: PRF_PreSplit_Raw.xlsx       (%d KB)  — categorical columns as text", round(file.size("PRF_PreSplit_Raw.xlsx") / 1024)))
message("Saved PRF_PreSplit_Raw.xlsx")
for (cn in cases_nonempty) {
  df <- presplit_raw[[cn]]
  log_info(sprintf("    %-22s %5d rows x %3d cols | PRF: %d events (%.2f%%)", CASE_INFO[[cn]]$label, nrow(df), ncol(df), sum(df$PRF == "PRF"), 100 * mean(df$PRF == "PRF")))
}

write_xlsx(enc_sheets, path = "PRF_PreSplit_Encoded.xlsx")
log_info(sprintf("Saved: PRF_PreSplit_Encoded.xlsx   (%d KB)  — k-1 dummy encoded", round(file.size("PRF_PreSplit_Encoded.xlsx") / 1024)))
message("Saved PRF_PreSplit_Encoded.xlsx")
for (cn in cases_nonempty) {
  df <- presplit_enc[[cn]]
  log_info(sprintf("    %-22s %5d rows x %3d cols", CASE_INFO[[cn]]$label, nrow(df), ncol(df)))
}

# Also write each case as its own standalone flat CSV -- same content as the
# "Raw" sheet above, but one file per case rather than bundled into a single
# multi-sheet workbook. This is the format needed for handing a specific
# case directly to a downstream ML job (e.g. preop_intraop_map_only.csv for
# Dr. Trivedi's MAP-only Preop+Intraop request) or for the correlation/
# statistical-analysis scripts, which expect one dataset file per case
# rather than a sheet reference inside a workbook.
dir.create("case_datasets", showWarnings = FALSE)
log_info("Flat per-case CSVs (case_datasets/):")
for (cn in cases_nonempty) {
  df <- presplit_raw[[cn]]
  out_path <- file.path("case_datasets", sprintf("%s.csv", cn))
  write.csv(df, out_path, row.names = FALSE)
  log_info(sprintf("    %-22s -> %-45s %5d rows x %3d cols | PRF: %d events (%.2f%%)", cn, out_path, nrow(df), ncol(df), sum(df$PRF == "PRF"), 100 * mean(df$PRF == "PRF")))
}
if (length(cases_empty) > 0) {
  log_info(sprintf("    (skipped empty case(s): %s)", paste(cases_empty, collapse = ", ")))
}



# 7. FINAL SUMMARY

log_info("=============================================")
log_info("EXPORT COMPLETE")
log_info("=============================================")

log_info(sprintf("PRF_Statistics_Table1.xlsx  %d KB  (%d case sheet(s) + Dataset Summary)", round(file.size("PRF_Statistics_Table1.xlsx") / 1024), length(cases_nonempty)))

if (length(ml_train_files) > 0) {
  log_info(sprintf("ML train/test exports (%d of %d cases had a usable split):", length(cases_split), length(cases_present)))
  for (i in seq_along(ml_train_files)) {
    log_info(sprintf("    %-30s %5d KB", ml_train_files[i], round(file.size(ml_train_files[i]) / 1024)))
    log_info(sprintf("    %-30s %5d KB", ml_test_files[i],  round(file.size(ml_test_files[i])  / 1024)))
  }
} else {
  log_info("No cases had a usable train/test split -- no ML train/test files exported.")
}

log_info(sprintf("PRF_PreSplit_Raw.xlsx       %d KB  (%d sheets)", round(file.size("PRF_PreSplit_Raw.xlsx") / 1024), length(cases_nonempty)))
log_info(sprintf("PRF_PreSplit_Encoded.xlsx   %d KB  (%d sheets)", round(file.size("PRF_PreSplit_Encoded.xlsx") / 1024), length(cases_nonempty)))
log_info(sprintf("case_datasets/*.csv         %d flat per-case CSVs (whole dataset, pre-split, no oversampling)", length(cases_nonempty)))

log_info("Key reminders:")
log_info("  1. Table 1 uses REAL patient data only — never oversampled.")
log_info("  2. Training sets contain SMOTE-NC synthetic rows — ML use only.")
log_info("  3. Test sets contain REAL patients at natural PRF prevalence.")
log_info("  4. PRF is always the last column in every ML dataset sheet.")
log_info("  5. Row 1 of each ML sheet is a metadata note, not a patient record.")
if (length(cases_skipped) > 0) {
  log_info(sprintf("  6. %d case(s) had no train/test split due to insufficient data: %s.", length(cases_skipped), paste(cases_skipped, collapse = ", ")))
  log_info("     Table 1 for these cases still reflects real (if small) patient counts.")
}
if (length(cases_empty) > 0) {
  log_info(sprintf("  7. %d case(s) are completely EMPTY (0 patients): %s.", length(cases_empty), paste(cases_empty, collapse = ", ")))
  log_info("     No Table 1, no pre-split export, no ML export for these -- likely because no patient has BP recorded in all of the required phases simultaneously.")
}
log_info(sprintf("Completed: %s", format(Sys.time())), console = TRUE)
