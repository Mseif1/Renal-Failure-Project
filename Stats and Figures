                      # These pre-split exports are for correlation/statistical
                      # analysis on real, un-oversampled data -- keep raw
                      # Platelet Count (more clinically interpretable) and
                      # drop the ML-only log-transformed version.
                      "Platelet_Count_log")

# Helper: clean and label a pre-split dataset
clean_presplit <- function(df) {
  df %>%
    select(-any_of(DROP_OPERATIONAL)) %>%
    mutate(PRF = ifelse(PRF == 1, "PRF", "No_PRF"))
}

# Helper: k-1 dummy encode a pre-split dataset
encode_presplit <- function(df) {
  # Separate PRF and New_MRN before encoding; reattach after
  prf_col    <- df$PRF
  mrn_col    <- df$New_MRN
  feat_df    <- select(df, -PRF, -New_MRN)

  # Convert character columns to factors for dummy_cols
  feat_df <- mutate(feat_df, across(where(is.character), as.factor))

  factor_cols <- names(feat_df)[sapply(feat_df, is.factor)]

  if (length(factor_cols) > 0) {
    feat_df <- dummy_cols(feat_df,
                          select_columns          = factor_cols,
                          remove_first_dummy      = TRUE,
                          remove_selected_columns = TRUE)
  }

  # Reattach New_MRN and PRF
  bind_cols(data.frame(New_MRN = mrn_col), feat_df, data.frame(PRF = prf_col))
}

